# Copy this file to .env and fill in real values. Nothing here is a working secret.
# On Render, set the same names under the service's Environment tab.

# --- Required ---
MONGODB_URI=                     # MongoDB connection string
JWT_SECRET=                      # any long random string

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=                     # comma-separated list of allowed frontend origins
FRONTEND_URL=                    # address of the app (frontend), used for the link in "reset PIN" emails. Defaults to the first CORS_ORIGIN
APP_URL=                         # legacy: only a last resort for reset links. Prefer FRONTEND_URL
PORTAL_OWNER_ID=                 # optional: which owner the public customer portal shop belongs to

# --- Nightly jobs and backups ---
CRON_SECRET=                     # long random string. cron-job.org / GitHub send it as the X-Cron-Secret header to POST /api/cron/run
BACKUP_PASSPHRASE=               # REQUIRED for backups. Encrypts every backup. Keep a copy somewhere safe: backups cannot be opened without it
BACKUP_EMAIL_TO=                 # optional: also email a copy of the encrypted backup once a week to this address
BACKUP_DAYS_OF_WEEK=0            # optional: which weekday(s) the email copy goes out, India time, 0 = Sunday ... 6 = Saturday (comma-separated)
ENABLE_INTERNAL_SCHEDULER=       # local development only: set to true to run the nightly jobs from inside the server
ALL_JOBS_CRON=                   # local development only: cron time for the internal scheduler (default 0 20 * * *)

# --- Email (Brevo HTTP API; Render's free plan blocks normal SMTP) ---
BREVO_API_KEY=
EMAIL_FROM=                      # must be a sender you verified in Brevo

# --- Telegram daily report and backups ---
# The nightly encrypted backup is sent to this same bot and chat as the daily report.
# Also used to store vendor invoice photos (see services/telegramStorage.js), and to send
# the "new customer portal access request" alert, so you hear about requests when the app is closed.
# If you'd rather keep invoice photos in a separate chat, set INVOICE_TELEGRAM_BOT_TOKEN / INVOICE_TELEGRAM_CHAT_ID instead.
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=
INVOICE_TELEGRAM_BOT_TOKEN=
INVOICE_TELEGRAM_CHAT_ID=

# --- Error alerts (set ONE of these; each is optional) ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=              # alert bot (can be the same bot as above)
TELEGRAM_CHAT_ID=

# --- Customer portal media uploads (Cloudinary, free plan) ---
# Needed for "Upload from computer" in the app's Customer Portal screen. See CLOUDINARY-SETUP.md.
# Keep the secret on the server only — never in the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini (optional — used by capture/receipt-parsing features) ---
GEMINI_API_KEY=
GEMINI_MODEL=
