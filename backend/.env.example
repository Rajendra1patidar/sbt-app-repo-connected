# Copy this file to .env and fill in real values. Nothing here is a working secret.

# --- Required ---
MONGODB_URI=                     # MongoDB connection string
JWT_SECRET=                      # any long random string

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=                     # comma-separated list of allowed frontend origins
APP_URL=                         # public URL of this API (used in links sent to users)

# --- Email (optional — falls back to console logging if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Telegram daily report (optional) ---
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=

# --- Gemini (optional — used by capture/receipt-parsing features) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Scheduled job cron overrides (optional — sane defaults exist in code) ---
DAILY_REPORT_CRON=
RECONCILIATION_CRON=
REORDER_CHECK_CRON=
CREDIT_CHECK_CRON=
