# URL of your deployed backend (Render), no trailing slash.
# For local dev against a local backend, leave this pointing at localhost.
VITE_API_URL=http://localhost:5000

# In Netlify: Site settings > Environment variables > add VITE_API_URL
# with your Render URL, e.g. https://sbt-backend.onrender.com

# Mapbox access token, used for the "pick on map" customer location picker
# and the estimates-by-place report map. Free tier covers normal shop usage
# (50k map loads/month), no billing account or ID verification required.
# Get one at https://account.mapbox.com/access-tokens/
# In Netlify: Site settings > Environment variables > add VITE_MAPBOX_TOKEN
VITE_MAPBOX_TOKEN=
